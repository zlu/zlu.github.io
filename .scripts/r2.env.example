# Copy to r2.env (gitignored) after creating the R2 bucket + API token.
# Setup (Cloudflare dashboard — no Worker):
#   1. R2 → Create bucket (e.g. zlu-photos)
#   2. Bucket → Settings → Public access → Custom Domain → media.zlu.me
#      (or use the r2.dev public URL temporarily and set R2_PUBLIC_BASE to that)
#   3. R2 → Manage R2 API Tokens → Create Account API token
#      Permission: Object Read & Write on that bucket
#   4. Fill the values below

R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET=zlu-photos
R2_PUBLIC_BASE=https://media.zlu.me
